{
  "name": "ln-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Electron desktop app đọc Light Novel với TTS local, phụ đề sync theo từ",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "pnpm -r --stream typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm -r --stream build",
    "build:win": "pnpm build && electron-builder --win --config electron-builder.yml"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  }
}
